# Google Gemini API keys (read by lib/api-key-rotation.ts)
#
# Only the first key is REQUIRED for the app to work.
# Keys 2-5 are OPTIONAL — if provided, requests are spread across them
# in a simple round-robin to help avoid per-key rate limits.
#
# Get a key at: https://aistudio.google.com/apikey

# Required
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional (leave blank if unused)
GOOGLE_GENERATIVE_AI_API_KEY_2=
GOOGLE_GENERATIVE_AI_API_KEY_3=
GOOGLE_GENERATIVE_AI_API_KEY_4=
GOOGLE_GENERATIVE_AI_API_KEY_5=
